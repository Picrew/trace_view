{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@core/*": ["./src/core/*"]
    }
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "src/core/schema.ts", "src/core/util.ts", "vite.config.ts"]
}
